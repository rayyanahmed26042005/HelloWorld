version: "3.8"

services:
  campusmgmt:
    image: USERNAME/hms
    container_name: campusmgmt_app
    ports:
      - "7079:7079"
    depends_on:
      - mysql             # 👈 change dependency name

  mysql:                  # 👈 service name changed
    image: mysql:8        # 👈 SQL database image
    container_name: campusmgmt_mysql
    environment:         # 👈 credentials
      MYSQL_ROOT_PASSWORD: rootpass
      MYSQL_DATABASE: campusdb
      MYSQL_USER: campususer
      MYSQL_PASSWORD: campuspass
    ports:
      - "3306:3306"       # 👈 default MySQL port
    volumes:
      - mysql_data:/var/lib/mysql  # 👈 MySQL data dir

volumes:
  mysql_data:
